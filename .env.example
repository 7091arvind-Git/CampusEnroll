# ==============================================================================
# CampusEnroll – Smart Environment Configuration Template
# Copy this file to '.env' and modify settings for local/production environments
# ==============================================================================

# Application Environment Mode (development / production)
FLASK_ENV=development
FLASK_DEBUG=True

# Session Security Secret Key (Replace with a strong random key in production)
SECRET_KEY=campusenroll-secure-secret-key-change-in-production

# Maximum Semester Credit Limit (Default: 24 credits)
MAX_CREDIT_LIMIT=24

# Server Host and Port
PORT=5000
HOST=127.0.0.1

# Database File Path (Leave blank to use default database.db in project root)
# DATABASE_PATH=database.db
